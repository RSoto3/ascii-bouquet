# Copy this file to .env and fill in your own values.
# Dates use YYYY-MM-DD.

# Page title (browser tab)
PAGE_TITLE=Lirios para ti 💐

# Browser tab icon: one emoji (e.g. 💐 🌸 ❤️ 🌷)
FAVICON=💐

# Previews via URL: ?test=mes (monthiversary), ?test=anio (anniversary), ?test=cumple (birthday).
# Use true only for local testing; keep false when deploying.
ENABLE_TEST=false

# Names shown in the counter: "NAME_A ♥ NAME_B"
NAME_A=Ana
NAME_B=Beto

# When you started dating (the counter starts at 00:00 that day)
START_DATE=2025-01-01

# Birthday: the day/month triggers the cake theme, the year computes the age
BIRTHDAY_NAME=Ana
BIRTHDAY_DATE=2000-01-01

# Optional messages ({n} = years together, {age} = age, {name} = BIRTHDAY_NAME)
MSG_MONTHIVERSARY=feliz cumple mes 💐
MSG_ANNIVERSARY_FIRST=feliz aniversario 💐
MSG_ANNIVERSARY=feliz {n} años 💐
MSG_BIRTHDAY=¡felices {age}, {name}! 🎂
